# BrewCMS Environment Configuration

# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Database
# For SQLite (local default):
DATABASE_URL=file:./data/brew.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/brew_cms
# For MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/brew_cms

# Authentication
# Secret used for session signing and API key hashing
AUTH_SECRET=change-me-to-a-secure-random-32-byte-hex-string

# Media Storage Provider
# Options: local | s3 | r2
MEDIA_PROVIDER=local
MEDIA_UPLOAD_DIR=./uploads
# S3 / Cloudflare R2 settings (when MEDIA_PROVIDER=s3 or r2)
# MEDIA_BUCKET=brew-cms-assets
# MEDIA_REGION=auto
# MEDIA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://assets.example.com

# Webhooks
WEBHOOK_SECRET=change-me-to-a-secure-signing-secret

# Logging & Observability
LOG_LEVEL=info
